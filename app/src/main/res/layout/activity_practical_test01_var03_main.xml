<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

    <EditText
        android:id="@+id/product_name_edit_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:hint="Numar"
        android:orientation="horizontal"
        android:inputType="number"
        android:textAlignment="center" />
        <Button
            android:id="@+id/add_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="+" />

        <!-- [AICI SCHIMBI]: id-ul si textul butonului CLEAR -->
        <Button
            android:id="@+id/minus_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:text="-" />
    <!-- [AICI SCHIMBI]: id-ul si inputType numberDecimal pentru Preț -->
    <EditText
        android:id="@+id/product_price_edit_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:hint="numar"
        android:inputType="number"
        android:orientation="horizontal"
        android:textAlignment="center" />
</LinearLayout>


    <TextView
        android:id="@+id/summary_edit_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1+1=2"
        android:focusable="false"
        android:clickable="false"
        android:textAlignment="center"
        android:layout_marginBottom="16dp" />


<Button
        android:id="@+id/navigate_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginBottom="32dp"
        android:text="NAVIGATE TO SECONDARY ACTIVITY" />

</LinearLayout>